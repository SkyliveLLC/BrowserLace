{
  "name": "@browserlace/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox && wxt build -b safari",
    "zip": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc",
    "safari:xcode": "xcrun safari-web-extension-converter .output/safari-mv3 --project-location safari --app-name BrowserLace --bundle-identifier app.browserlace.BrowserLace --swift --no-open --no-prompt --force",
    "icons": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "@browserlace/core": "workspace:*",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@browserlace/server": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^6.0.3",
    "wxt": "^0.21.4"
  }
}
